r 1fr;gap:22px;align-items:start}\n  .plan{background:#fffaf0;border-radius:var(--radius);padding:30px 28px;box-shadow:var(--shadow);border:1px solid rgba(203,189,146,.55);position:relative}\n  .plan.pick{background:#fffdf6;border:2px solid var(--green)}\n  .plan.pick::after{content:\"推荐\";position:absolute;top:-13px;right:26px;background:var(--green);color:var(--cream);font-size:12.5px;letter-spacing:.16em;padding:5px 14px;border-radius:999px;font-weight:700}\n  .plan h3{font-size:1.28rem;margin-bottom:6px}\n  .plan .price{font-size:2rem;font-weight:800;color:var(--green);letter-spacing:-.02em;line-height:1.1;margin:12px 0 4px}\n  .plan .price small{font-size:.9rem;font-weight:500;color:var(--ink-soft);letter-spacing:0}\n  .plan .annual{font-size:14px;color:var(--ink-soft);margin-bottom:18px}\n  .plan ul{display:grid;gap:10px;border-top:1px dashed var(--line);padding-top:18px}\n  .plan li{font-size:15px;color:var(--ink-soft);padding-left:20px;position:relative}\n  .plan li::before{content:\"\";position:absolute;left:0;top:.62em;width:8px;height:8px;border-radius:50%;background:var(--green-light)}\n  .note{margin-top:26px;font-size:13.5px;color:var(--ink-soft);max-width:48em}\n\n  /* ---------- 客户端 ---------- */\n  .clients-wrap{display:grid;grid-template-columns:.9fr 1.1fr;gap:40px;align-items:start}\n  .client-list{display:grid;gap:14px}\n  .client{background:#fffaf0;border-radius:20px;padding:20px 24px;box-shadow:var(--shadow);border:1px solid rgba(203,189,146,.45);display:flex;justify-content:space-between;align-items:baseline;gap:16px}\n  .client h3{font-size:1.02rem;margin:0}\n  .client span{font-size:13px;color:var(--green-light);letter-spacing:.06em;white-space:nowrap}\n  .client p{margin:6px 0 0;font-size:14px;color:var(--ink-soft);grid-column:1 / -1;flex-basis:100%}\n  .client-row{display:flex;flex-direction:column}\n  .client-inner{display:flex;justify-content:space-between;gap:16px;align-items:baseline}\n\n  /* ---------- FAQ 对话气泡 ---------- */\n  .qa{display:grid;gap:18px}\n  .bubble-q{justify-self:start;max-width:min(100%,640px);background:var(--green);color:var(--cream);border-radius:22px 22px 22px 6px;padding:18px 24px;box-shadow:var(--shadow)}\n  .bubble-q h3{font-size:1.02rem;margin:0;font-weight:700;color:var(--cream)}\n  .bubble-q .tag{display:block;font-size:12px;letter-spacing:.24em;color:#b7d4c4;margin-bottom:6px}\n  .bubble-a{justify-self:end;max-width:min(100%,700px);background:#fffaf0;border-radius:22px 22px 6px 22px;padding:20px 24px;border:1px solid rgba(203,189,146,.6);box-shadow:var(--shadow)}\n  .bubble-a p{margin:0;font-size:15.5px;color:var(--ink-soft)}\n  .bubble-a p + p{margin-top:10px}\n\n  /* ---------- 收尾 ---------- */\n  .outro{background:var(--green);color:var(--cream);padding:58px 0}\n  .outro h2{font-size:clamp(1.4rem,3vw,1.9rem);color:var(--cream);margin-bottom:14px}\n  .outro p{color:#d3e4da;max-width:42em;font-size:15.5px}\n  .outro a{color:var(--cream);border-bottom-color:rgba(246,236,205,.5)}\n  .outro .backtop{display:inline-block;margin-top:10px;font-size:14px;letter-spacing:.08em}\n\n  footer{padding:30px 0 46px;font-size:13.5px;color:var(--ink-soft)}\n  footer .foot{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:22px}\n\n  @media (max-width:860px){\n    .hero-grid{grid-template-columns:1fr;gap:30px}\n    .steps{grid-template-columns:1fr}\n    .plan-grid{grid-template-columns:1fr}\n    .clients-wrap{grid-template-columns:1fr;gap:26px}\n    section{padding:52px 0}\n  }\n  @media (max-width:520px){\n    body{font-size:16px}\n    .plan .price{font-size:1.7rem}\n    .client{padding:18px 20px}\n    .bubble-q,.bubble-a{padding:16px 18px}\n  }\n</style><header class=\"hero\" id=\"top\">\n  <div class=\"wrap\">\n    <div class=\"brandline\">\n      <div class=\"brandmark\">CLAPSE <span>／ 订阅说明</span></div>\n      <nav class=\"anchors\" aria-label=\"页面内跳转\">\n        <a href=\"#how\">怎么用</a>\n        <a href=\"#plans\">套餐</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n\n    <div class=\"hero-grid\">\n      <div>\n        <div class=\"kicker\">一份写得比较长的说明</div>\n        <h1>CLAPSE\n          <em>先把话说清楚，再谈订阅。</em>\n        </h1>\n        <p class=\"lede\">市面上很多订阅页都把重点放在形容词上。<strong>CLAPSE 的做法相反：</strong>把每月给多少流量、能同时挂几台设备、哪一档适合什么样的人，一条条写在明面上。你不必读完整篇，扫一眼表格就能做决定；如果你愿意读下去，我们也把理由留在这里。</p>\n        <p class=\"lede\">下面的内容分成四块：怎么用、套餐怎么选、客户端放在哪、以及那些总被问到的细节。顺序不重要，按需跳转即可。</p>\n      </div>\n\n      <aside class=\"hero-note\" aria-label=\"一页速览\">\n        <h2>一页速览</h2>\n        <dl>\n          <div>\n            <dt>档位</dt>\n            <dd>三档：基础版 / 旗舰版 / 团队版</dd>\n          </div>\n          <div>\n            <dt>计费</dt>\n            <dd>月付或年付，年付价格写在每一档里</dd>\n          </div>\n          <div>\n            <dt>设备</dt>\n            <dd>分别对应 3 / 5 / 20 台同时在线</dd>\n          </div>\n          <div>\n            <dt>流量</dt>\n            <dd>分别对应 100GB / 300GB / 1000GB 每月</dd>\n          </div>\n        </dl>\n        <div class=\"divider\"></div>\n        <p class=\"small\">本页只陈述套餐本身的配置与使用方式。具体线路状态、可用区域与开通流程，请以你实际看到的账户信息为准。</p>\n      </aside>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div class=\"eyebrow\">使用说明</div>\n        <h2>三步之内，从零到能用</h2>\n        <p>没有复杂流程。选档、装客户端、登录，就这三件事。下面把每步写细一点，省得你到处找。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"num\">01</span>\n          <h3>选一档，别纠结太久</h3>\n          <p>先看设备数。一个人用两三台，基础版够；手机、平板、电脑加电视盒子全都要挂，旗舰版的 5 台更稳。团队版留给多人共用一个账户的场景，20 台同时在线，配 1000GB 月流量。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"num\">02</span>\n          <h3>装客户端，登录</h3>\n          <p>按你手上的设备选对应客户端，装好后用账户信息登录。不要重复安装多个版本，同一台设备只保留一个即可，避免互相抢占连接。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"num\">03</span>\n          <h3>按需切换，别一直满速跑</h3>\n          <p>看视频和日常浏览用普通线路就够；对延迟敏感的场景再切到专线类节点。流量是共享的，习惯性地把大文件更新挂在后台，配额会用得比你想象得快。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"plans-block\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div class=\"eyebrow\">套餐</div>\n        <h2>两栏对照：基础版、旗舰版，以及团队版</h2>\n        <p>价格、流量、设备数全部列在卡里。年付价按 10 个月计，一次性付清。没有隐藏项，也没有需要打电话才能问到的部分。</p>\n      </div>\n\n      <div class=\"plan-grid\">\n        <article class=\"plan\">\n          <h3>基础版</h3>\n          <div class=\"price\">¥15 <small>/ 月</small></div>\n          <div class=\"annual\">按年付 ¥150 / 年</div>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan pick\">\n          <h3>旗舰版</h3>\n          <div class=\"price\">¥35 <small>/ 月</small></div>\n          <div class=\"annual\">按年付 ¥350 / 年</div>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <h3>团队版</h3>\n          <div class=\"price\">¥85 <small>/ 月</small></div>\n          <div class=\"annual\">按年付 ¥850 / 年</div>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n      </div>\n\n      <p class=\"note\">两栏并排的是基础版与旗舰版，团队版单独一栏，因为它面对的是多人共用而非个人升级。若你只想知道「该不该从基础版换到旗舰版」，答案通常取决于两件事：是否需要接近 5 台设备同时在线，以及是否在意流媒体解锁的覆盖范围。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"clients-wrap\">\n        <div class=\"section-head\">\n          <div class=\"eyebrow\">客户端</div>\n          <h2>客户端放在哪里</h2>\n          <p>我们不在这里提供下载按钮。请通过你实际收到的账户说明或官方渠道获取安装包，避免第三方来源的替换版本。下面按设备列出对应关系。</p>\n          <p>同一账户在不同设备上登录，会占用相应的同时在线名额。登出即释放，不必担心一次登录就永久占用。</p>\n        </div>\n\n        <div class=\"client-list\">\n          <article class=\"client\">\n            <div class=\"client-row\">\n              <div class=\"client-inner\">\n                <h3>Windows 桌面端</h3>\n                <span>占用 1 台</span>\n              </div>\n              <p>适合长期在电脑上使用。安装后先登录再选择线路，切换线路时旧的连接会自动断开。</p>\n            </div>\n          </article>\n          <article class=\"client\">\n            <div class=\"client-row\">\n              <div class=\"client-inner\">\n                <h3>macOS 桌面端</h3>\n                <span>占用 1 台</span>\n              </div>\n              <p>与 Windows 端使用同一账户体系。若同时开着两台电脑，会按两台计算在线设备。</p>\n            </div>\n          </article>\n          <article class=\"client\">\n            <div class=\"client-row\">\n              <div class=\"client-inner\">\n                <h3>iOS 客户端</h3>\n                <span>占用 1 台</span>\n              </div>\n              <p>手机与平板分别计为一台设备。外出时优先用这一端，回到固定网络后记得登出以腾出名额。</p>\n            </div>\n          </article>\n          <article class=\"client\">\n            <div class=\"client-row\">\n              <div class=\"client-inner\">\n                <h3>Android 客户端</h3>\n                <span>占用 1 台</span>\n              </div>\n              <p>安装包请从账户说明中给出的渠道获取。不要在同一台设备上保留旧版本，新旧版本同时运行会互相干扰。</p>\n            </div>\n          </article>\n          <article class=\"client\">\n            <div class=\"client-row\">\n              <div class=\"client-inner\">\n                <h3>路由器 / 家庭网络</h3>\n                <span>占用 1 台</span>\n              </div>\n              <p>在路由器上统一配置后，家庭内多台设备共享一个在线名额。适合设备多但不常同时外出的场景。</p>\n            </div>\n          </article>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div class=\"eyebrow\">常见问题</div>\n        <h2>你大概会问到的几件事</h2>\n        <p>下面是问答形式的整理。左边是问题，右边是回答，按你关心的点往下翻。</p>\n      </div>\n\n      <div class=\"qa\">\n        <div class=\"bubble-q\">\n          <span class=\"tag\">问 · 01</span>\n          <h3>月付和年付差在哪里？</h3>\n        </div>\n        <div class=\"bubble-a\">\n          <p>只差付款周期和总额。年付按 10 个月的价格一次性收取：基础版 ¥150 / 年，旗舰版 ¥350 / 年，团队版 ¥850 / 年。权益内容完全一致，不会因为年付多送流量或多给设备名额。</p>\n        </div>\n\n        <div class=\"bubble-q\">\n          <span class=\"tag\">问 · 02</span>\n          <h3>我到底该选哪一档？</h3>\n        </div>\n        <div class=\"bubble-a\">\n          <p>先数设备。常年同时在线的设备超过 3 台，就直接看旗舰版。再看流量：一个月内如果会在多个设备上长时间看视频，100GB 会偏紧，300GB 更从容。团队版的 1000GB 和 20 台名额，是给合用一个账户的多人场景准备的。</p>\n        </div>\n\n        <div class=\"bubble-q\">\n          <span class=\"tag\">问 · 03</span>\n          <h3>流量用完了会怎样？</h3>\n        </div>\n        <div class=\"bubble-a\">\n          <p>配额按月计算，用尽后当月不再继续提供流量，下一个周期自动重置。年付不会因为某个月没用完而把余量累积到下个月，所以选择档位时按你的平均用量来定，而不是偶尔的高峰。</p>\n        </div>\n\n        <div class=\"bubble-q\">\n          <span class=\"tag\">问 · 04</span>\n          <h3>换设备需要额外付费吗？</h3>\n        </div>\n        <div class=\"bubble-a\">\n          <p>不需要。设备数量指的是「同时在线」的上限，不是终身绑定的台数。登出一台、再登录另一台，名额会自动释放并重新分配。</p>\n        </div>\n\n        <div class=\"bubble-q\">\n          <span class=\"tag\">问 · 05</span>\n          <h3>客户端从哪里下载？</h3>\n        </div>\n        <div class=\"bubble-a\">\n          <p>请以你账户说明中提供的官方渠道为准，本页不提供安装包，也不列出下载地址。请勿使用来路不明的第三方安装文件，那些文件的内容无法被核对。</p>\n        </div>\n\n        <div class=\"bubble-q\">\n          <span class=\"tag\">问 · 06</span>\n          <h3>线路会不会经常变化？</h3>\n        </div>\n        <div class=\"bubble-a\">\n          <p>线路池会按运营需要调整，这一点任何服务都避免不了。我们不对具体节点数量、分布区域或稳定性作出承诺，只说明套餐层面的配置差异：普通线路节点池、IPLC 专线、VIP 专属高带宽节点，分别对应三档。</p>\n        </div>\n\n        <div class=\"bubble-q\">\n          <span class=\"tag\">问 · 07</span>\n          <h3>团队版可以开发票吗？</h3>\n        </div>\n        <div class=\"bubble-a\">\n          <p>团队版含专属客户经理服务，开票、账户管理与路由定制相关事宜请在开通前先与对接人确认。本页不代为承诺具体票据类型或流程时效。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<section class=\"outro\">\n  <div class=\"wrap\">\n    <h2>看到这里，应该够了</h2>\n    <p>三档套餐、五个客户端、七条问答，都写在上面了。剩下的判断留给你：先数设备，再看流量，最后决定月付还是年付。如果仍有疑问，请通过账户说明中的联系方式处理。</p>\n    <a class=\"backtop\" href=\"#top\">回到开头 ↑</a>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot\">\n      <span>CLAPSE · 订阅说明页</span>\n      <span>本页内容仅描述套餐配置与使用方式，不构成对线路性能的承诺。</span>\n    </div>\n  </div>\n</footer>",
